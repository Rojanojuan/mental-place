{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "vite-plugin-pwa/client", "vitest/globals", "node"],

    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,

    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "noEmit": true,

    "paths": {
      "@/*": ["./src/*"]
    }
  },
  // `worker/` es el servidor de avisos: JavaScript plano que corre en
  // Cloudflare. Solo entran sus tipos, para que los tests lo importen.
  "include": ["src", "tests", "worker/src/index.d.ts"],
  // El service worker se comprueba aparte: usa la librería WebWorker, no DOM.
  "exclude": ["src/sw.ts"]
}
